{
  "rewrites": [
    {
      "source": "/api/frankfurter/:path*",
      "destination": "https://api.frankfurter.dev/v1/:path*"
    },
    {
      "source": "/api/opensky/:path*",
      "destination": "https://opensky-network.org/:path*"
    },
    {
      "source": "/api/rba/:path*",
      "destination": "https://api.rba.gov.au/:path*"
    },
    {
      "source": "/api/reservebank/:path*",
      "destination": "https://www.rba.gov.au/:path*"
    },
    {
      "source": "/api/fred/:path*",
      "destination": "https://fred.stlouisfed.org/:path*"
    },
    {
      "source": "/api/stooq/:path*",
      "destination": "https://stooq.com/:path*"
    },
    {
      "source": "/api/imf/:path*",
      "destination": "https://www.imf.org/external/datamapper/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), fullscreen=(self), clipboard-write=(self)"
        },
        {
          "key": "Reporting-Endpoints",
          "value": "csp=\"/api/csp-report\""
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' data: https://onzaybvpqkpqupzluapo.supabase.co https://api.coingecko.com https://api.alternative.me https://mempool.space https://raw.githubusercontent.com https://api.binance.com https://earthquake.usgs.gov https://tiles.openfreemap.org; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp-report; report-to csp"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/ai-daily?generate=all",
      "schedule": "0 19 * * *"
    }
  ],
  "functions": {
    "api/ai-daily.js": {
      "maxDuration": 60
    }
  }
}
