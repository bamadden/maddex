{
  "rewrites": [
    {
      "source": "/api/frankfurter/:path*",
      "destination": "https://api.frankfurter.dev/v1/:path*"
    },
    {
      "source": "/api/opensky/:path*",
      "destination": "https://opensky-network.org/:path*"
    },
    {
      "source": "/api/rba/:path*",
      "destination": "https://api.rba.gov.au/:path*"
    },
    {
      "source": "/api/reservebank/:path*",
      "destination": "https://www.rba.gov.au/:path*"
    },
    {
      "source": "/api/fred/:path*",
      "destination": "https://fred.stlouisfed.org/:path*"
    },
    {
      "source": "/api/stooq/:path*",
      "destination": "https://stooq.com/:path*"
    },
    {
      "source": "/api/imf/:path*",
      "destination": "https://www.imf.org/external/datamapper/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
