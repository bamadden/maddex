# Anthropic API key — used for AI chat features in the terminal
VITE_ANTHROPIC_API_KEY=

# ExchangeRate-API key — used for metals pricing in the FX module
VITE_EXCHANGERATE_API_KEY=

# Financial Modeling Prep key — powers all equity and index quotes/history.
# Sign up free (no card) at financialmodelingprep.com, 250 req/day on the
# free tier. Without a real key here, quotes/history will fail — FMP retired
# public "demo" key access.
VITE_FMP_API_KEY=

# Supabase — auth, user profiles, and data persistence
# Add both of these to the Vercel dashboard environment variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
